# --- Cloudflare D1 ---
# Account ID: `npx wrangler whoami` ou painel da Cloudflare (barra lateral direita da home)
CLOUDFLARE_ACCOUNT_ID=
# Database ID (UUID): saída de `npx wrangler d1 create face_api` ou painel > D1 > seu banco
CLOUDFLARE_D1_DATABASE_ID=
# API Token com permissão Account > D1 > Edit
CLOUDFLARE_API_TOKEN=
# Timeout (segundos) de cada chamada à API REST do D1
D1_TIMEOUT_SECONDS=15

# --- Schema ---
# true cria as tabelas se não existirem (dev). Em produção deixe false.
AUTO_CREATE_TABLES=true

# --- Nomes de tabela/coluna (só mexa se o schema da outra API for diferente) ---
# PESSOA_TABLE=pessoa
# PESSOA_PK=cpf
# PESSOA_NOME_COL=nome
# PESSOA_FOTO_COL=foto
# LOGS_TABLE=logs
# LOGS_FK_COL=pessoa_cpf
# LOGS_DATETIME_COL=data_hora

# --- Regras de acesso ---
ACCESS_COOLDOWN_SECONDS=4
SIMILARITY_THRESHOLD=0.40
FACE_CACHE_TTL_SECONDS=60

# --- Motor facial ---
# Pacote de modelos (buffalo_l = mais preciso; buffalo_s = mais leve, recalibre o limiar)
FACE_MODEL=buffalo_l
# Resolução do detector: 320 para catraca (rosto perto); 480/640 se a câmera ficar longe
FACE_DET_SIZE=320
# Tamanho máximo da imagem enviada (bytes)
MAX_UPLOAD_BYTES=10485760

# --- Anti-spoofing (rosto vivo) ---
# true recusa foto/tela/impressão na frente da câmera (motivo rosto_nao_vivo).
# Na 1ª execução baixa liveness.onnx (~1,5 MB) para ~/.insightface/addons/
FACE_LIVENESS=true
# Probabilidade mínima (0–1) para considerar rosto vivo (0.8 = padrão do InsightFace)
LIVENESS_THRESHOLD=0.8
